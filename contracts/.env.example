# Contracts workspace only. Never used by, or copied into, the frontend.
# A raw deployer private key (0x-prefixed). Use a throwaway testnet key.
DEPLOYER_PRIVATE_KEY=
# Optional overrides
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Address that receives the non-creator share of each companion token supply.
TREASURY_ADDRESS=
# Optional admin address; defaults to the deployer.
ADMIN_ADDRESS=
# REQUIRED. Public address of the platform key that signs EIP-712 mint vouchers.
# Passports cannot be minted without it. The private key belongs in the app's server secrets only.
SIGNER_ADDRESS=
# Optional. Uniswap V3 position manager; set it to also deploy YardLiquidityLocker.
POSITION_MANAGER_ADDRESS=
# Blockscout usually needs no key.
EXPLORER_API_KEY=
