# ---------------------------------------------------------------------------
# YARD SALE contracts — deployment environment (contracts workspace ONLY)
#
# Copy to contracts/.env on the machine that performs the deployment.
# This file is read by hardhat.config.ts and the scripts in contracts/scripts.
# It is git-ignored. It is never bundled into, or read by, the web app.
# Never paste any of these values into Lovable, chat, or a VITE_* variable.
# ---------------------------------------------------------------------------

# ===== Robinhood Chain MAINNET (chainId 4663, gas token ETH) =====
# Raw 0x-prefixed private key of a dedicated deployer account. Fund it with a
# little ETH on Robinhood Chain, deploy, then stop using it. It holds no roles
# after deployment (they are handed to MAINNET_ADMIN_ADDRESS and renounced).
MAINNET_DEPLOYER_PRIVATE_KEY=

# Mainnet RPC. Public default: https://rpc.mainnet.chain.robinhood.com
RH_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Permanent administrator. Nonzero. Strongly recommended: a multisig you control.
# Receives DEFAULT_ADMIN_ROLE + PAUSER_ROLE + STATUS_ROLE on the registry and
# DEFAULT_ADMIN_ROLE + PAUSER_ROLE on the factory.
MAINNET_ADMIN_ADDRESS=

# Receives the non-creator share of every companion token supply.
# Optional; defaults to MAINNET_ADMIN_ADDRESS.
MAINNET_TREASURY_ADDRESS=

# The deploy script is a dry run unless this is exactly YES.
CONFIRM_MAINNET_DEPLOY=

# Blockscout verification normally needs no key.
BLOCKSCOUT_API_KEY=

# ===== Mainnet-fork simulation (no key needed) =====
# MAINNET_FORK=true makes the in-process hardhat network fork RH_MAINNET_RPC_URL
# with chainId 4663. Used by scripts/simulate-mainnet-deploy.ts.
MAINNET_FORK=

# ===== Robinhood Chain TESTNET (chainId 46630) =====
DEPLOYER_PRIVATE_KEY=
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
TREASURY_ADDRESS=
ADMIN_ADDRESS=
EXPLORER_API_KEY=
